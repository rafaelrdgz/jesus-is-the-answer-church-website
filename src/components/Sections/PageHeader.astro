---
export interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  lang?: string;
  heightClass?: string;
  positionClass?: string;
}

const { 
  title, 
  subtitle, 
  backgroundImage = "/uploads/page-header-bg.webp",
  lang = 'es',
  heightClass,
  positionClass,
} = Astro.props;

const sectionClasses = [
  "relative bg-cover",
  heightClass ? `${heightClass} flex items-center` : "py-20",
  positionClass ?? "bg-center",
].join(" ");
---

<section 
  class={sectionClasses}
  style={`background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url(${backgroundImage})`}
>
  <div class="container">
    <div class="max-w-3xl mx-auto text-center text-white">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">{title}</h1>
      {subtitle && <p class="text-xl md:text-2xl">{subtitle}</p>}
    </div>
  </div>
</section>
